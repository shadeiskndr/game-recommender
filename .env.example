# Self-hosted Convex deployment (required).
# Get the admin key by running ./generate_admin_key.sh in your Convex container.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Public Convex URLs (managed automatically by `npx convex dev`).
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Backfill script options (scripts/backfill.ts). All optional.
SQLITE_PATH='./videogames_with_embeddings.db'
CONCURRENCY='8'
START_OFFSET='0'

# Note: OPENAI_API_KEY is NOT set here — it lives on the Convex deployment.
# Set it once with: npx convex env set OPENAI_API_KEY sk-...
